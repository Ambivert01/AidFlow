# Safety net if git is initialized at this root rather than per-subproject.
# Each subproject (backend/, frontend/, blockchain/, ai-agents/) also has
# its own .gitignore - this just makes sure nothing here can slip through.

**/node_modules/
**/.env
!**/.env.example

**/venv/
**/__pycache__/
**/*.pyc

**/dist/
**/dist-ssr/
**/uploads/
**/*.log

**/.DS_Store
**/.vscode/*
!**/.vscode/extensions.json
**/.idea

# Hardhat
**/cache/
**/artifacts/
**/typechain-types/
blockchain/ignition/deployments/chain-31337
