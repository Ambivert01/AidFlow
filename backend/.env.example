PORT=5000
NODE_ENV=development

FRONTEND_URL=http://localhost:5173,http://localhost:5174

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aidflow?retryWrites=true&w=majority

JWT_SECRET=<run: openssl rand -hex 64>
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Must differ from JWT_SECRET - validateEnv() will refuse to boot if they match
QR_SECRET=<run: openssl rand -hex 32>

PII_HASH_SECRET=<run: openssl rand -hex 32>

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

AI_ELIGIBILITY_URL=http://localhost:8001
AI_FRAUD_URL=http://localhost:8002
AI_RISK_URL=http://localhost:8003
AI_PROOF_URL=http://localhost:8004

STORAGE_TYPE=LOCAL
UPLOAD_PATH=./uploads/proofs
# Used to build absolute URLs for locally-stored files (proof photos etc) so
# they're reachable from the frontend, which runs on a different origin.
# Only matters when STORAGE_TYPE=LOCAL - ignored for S3.
BACKEND_PUBLIC_URL=http://localhost:5000

RPC_URL=http://127.0.0.1:8545
AUDIT_CONTRACT_ADDRESS=<deployed contract address>
BLOCKCHAIN_PRIVATE_KEY=<your own dev wallet private key - NEVER the public Hardhat default for anything real>
